# Worksite GIS — 環境變數範本
# 複製此檔為 .env 並填入實際金鑰
# 警告：請勿將含有實際金鑰的 .env 提交至 Git

# ── Django 核心 ───────────────────────────────────────────
SECRET_KEY=請替換為強隨機字串（可用 python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())" 產生）
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── 資料庫（預設使用 SQLite，無需修改）────────────────────
# DB_ENGINE=sqlite
# DB_NAME=db.sqlite3

# ── 外部 API Keys（空白時對應功能降級，不影響啟動）────────
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
CWA_API_KEY=

# ── 選用設定 ──────────────────────────────────────────────
# TIME_ZONE=Asia/Taipei
# EXTERNAL_API_TIMEOUT_SECONDS=10
# EXTERNAL_API_CACHE_SECONDS=60
# WORKSITE_GEOCODING_PROVIDER=nominatim
# WORKSITE_NOMINATIM_GEOCODING_URL=https://nominatim.openstreetmap.org/search
# TGOS_API_KEY=
# TGOS_GEOCODING_URL=
# WORKSITE_NLSC_GEOCODING_URL=
# WORKSITE_NLSC_API_TOKEN=

# ── 選用整合 ──────────────────────────────────────────────
# TDX_STALE_MAX_SECONDS=600
# WRA_ENABLED=true
# WRA_ALLOWED_REGIONS=taoyuan

# ── 隔離部署 profile（config.deployment_settings）────────────
# WORKSITE_STATIC_ROOT=/path/to/isolated/staticfiles
# DJANGO_CSRF_TRUSTED_ORIGINS=https://approved.example.invalid
# DJANGO_TRUST_HTTPS_PROXY=0
# 啟用 HSTS 前先驗證 HTTPS 與網域政策
# DJANGO_SECURE_HSTS_SECONDS=0
# PostgreSQL 使用 DB_ENGINE、DB_NAME、DB_HOST、DB_USER、
# DB_PASSWORD、DB_PORT。由私密設定提供實際連線值。
